# =============================================================================
# PV Construction Platform — Environment Variables
# Copy to .env and fill in all values before running
# =============================================================================

# ---- Database (Postgres) ----
DATABASE_URL=postgresql://pvplatform:changeme@localhost:5432/pvplatform
POSTGRES_USER=pvplatform
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pvplatform

# ---- Tiledesk (self-hosted) ----
TILEDESK_BASE_URL=http://localhost:8081
TILEDESK_PROJECT_ID=
TILEDESK_API_TOKEN=
TILEDESK_GPTKEY=

# ---- Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# ---- ElevenLabs ----
ELEVENLABS_API_KEY=

# ---- AgentMail ----
AGENTMAIL_API_KEY=

# ---- Contractor Notifications ----
PRIMARY_CONTRACTOR_PHONE=
ADMIN_PHONE=

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TILEDESK_PROJECT_ID=
NEXT_PUBLIC_TILEDESK_BASE_URL=http://localhost:8081
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ---- Auth (admin dashboard) ----
ADMIN_PASSWORD=changeme
JWT_SECRET=change-this-to-a-random-64-char-string
