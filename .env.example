# Application
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://pv-construction-platform.vercel.app

# Database
DATABASE_URL=postgresql://user:password@host:5432/pv_construction

# Security
JWT_SECRET=your-jwt-secret-key-here

# Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ElevenLabs
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Tiledesk
TILEDESK_PROJECT_ID=your-tiledesk-project-id
TILEDESK_API_KEY=your-tiledesk-api-key

# Locale
NEXT_PUBLIC_DEFAULT_LOCALE=es-MX
